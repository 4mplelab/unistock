# PostgreSQL
POSTGRES_USER=unistock
POSTGRES_PASSWORD=change_me
POSTGRES_DB=unistock
POSTGRES_HOST=db
POSTGRES_PORT=5432

# BASE API (https://developers.thebase.in で取得)
BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
BASE_REDIRECT_URI=https://localhost/callback
BASE_API_BASE_URL=https://api.thebase.in

# BASEのトークンをDBに暗号化保存するための鍵。任意設定: 未設定の場合は初回起動時に
# 自動生成してDBに保存し、以降はそれを使い続ける(再起動しても変わらない)。
# 固定したい場合のみ、生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ==== UniStock自体へのログイン(OIDC/OAuth) ====
# falseにすると認証を完全に無効化する(ログイン不要で誰でも全機能を使える)。
# 信頼できるネットワーク内のみで公開する場合向け。
# インターネットに公開する場合は必ずtrue(未指定時のデフォルト)のままにすること
AUTH_ENABLED=true

# ==== デモモード(外部ショップのアカウントを持たない第三者向けのスタンドアロン展示用) ====
# 用語整理:「デモモード/通常モード」はこのフラグによる実行モード。「本番」は実際に
# いずれかのショップで連携済み(OAuthトークンが存在する)というデータの状態のことで、モードとは別概念。
# デモモードと本番は同じ永続化データ上で絶対に共存させない
#
# trueにすると、外部ショップ接続なし・ログイン不要で全機能を動かせるようになる。
# AUTH_ENABLEDとは完全に別のフラグ(AUTH_ENABLEDは常にtrueのまま使うこと)。
# false→trueに切り替えた起動時は自動でデータを全消去する(毎回真っさらな状態から
# 始まる。ショップ0件になるだけで、デモデータの再投入まではしない。デモデータは
# セットアップウィザードでショップを作成するときに選んで投入する)。true→falseに
# 切り替えた起動時も自動でデータを全消去する(再投入はしない)。true→true/
# false→falseのまま再起動しても何もしない。
#
# 安全策: 本番状態(実トークンあり)でtrueにしても、起動時に自動検知してデモモードでの
# 起動自体を拒否し、通常モードへ強制フォールバックする。デモモード中はOAuth連携APIも
# 塞いでいるため、デモモード中に本物のトークンが新規発行されることも無い。
# 本番からデモへ使い回すには `docker compose down -v` 等で永続化データを完全に
# 削除してから起動し直すこと(アプリの機能としては用意しない)
DEMO_MODE=false

# セッションCookieの署名キー。生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 未設定の場合は起動ごとにランダム生成される(再起動でOAuthログイン中の人がやり直しになるだけなので、
# お試し利用ならなくても動くが、本番運用では固定値を設定すること)
SESSION_SECRET_KEY=
SESSION_TTL_DAYS=30
# フロントエンド/バックエンドの公開URL。ログイン後のリダイレクト先や
# 各プロバイダに登録するコールバックURLの組み立てに使う
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
# 初回起動時、まだ誰も登録されていなければこの識別子(メールアドレス等)を
# 管理者として自動登録する。登録後は空に戻しても問題ない
#
# 任意設定: 未設定でも、まだ誰も登録されていない状態でログインに成功した
# 最初の1人が自動的に管理者として登録される(ログインコールバック側の
# フォールバック、routers/auth.py参照)。閉じたネットワークで
# 自分しかアクセスできないなら未設定のままで問題ない。インターネットに
# 公開する等、自分より先に他の誰かがログインしうる状況では、先着した人に
# 管理者を横取りされるレースを避けるためここに自分の識別子を設定しておくこと
INITIAL_ADMIN_IDENTIFIER=

# 使うプロバイダの分だけ設定すればOK(未設定のプロバイダはログインボタンを
# 押してもエラーになるだけで、他のプロバイダには影響しない)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ==== 通知(発注点割れ等の業務イベントをメールで送る場合) ====
# 未設定(SMTP_HOST空欄)ならメール通知機能自体が無効になる(設定画面でメール通知を
# オンにしても何も送信されない)。Webhook通知はここの設定と無関係に動く。
# 取得手順(Webhook URLの取得方法・Gmailのアプリパスワード発行手順も含む)は
# docs-siteの「設定」ページ(/docs/admin-guide/settings/#通知)を参照
#
# Gmailを使う場合、SMTP_PASSWORDには通常のログインパスワードではなく
# 「アプリパスワード」(16桁、2段階認証を有効化した上でmyaccount.google.com/apppasswordsで発行)が必要
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=

# バックグラウンドジョブの実行間隔・保持期間(未指定時はコード側のデフォルト値を使用)
# SCHEDULE_POLL_INTERVAL_SECONDS=30
# RESERVATION_RETRY_INTERVAL_SECONDS=300
# ORDER_STATUS_RECHECK_INTERVAL_SECONDS=300
# RETENTION_CLEANUP_INTERVAL_HOURS=24
# ITEM_CATEGORY_SYNC_INTERVAL_HOURS=6
# NOTIFICATION_CHECK_INTERVAL_SECONDS=300
# LOG_DIR=/app/logs
# LOG_FILE_NAME=backend.log
# LOG_ROTATION_WHEN=midnight
# LOG_ROTATION_BACKUP_COUNT=30

# Frontend
VITE_API_BASE_URL=/api

# コンテナレジストリのパス(docker-compose.prod.yml / scripts/build_and_push.sh で使用)。
# GitHub Container Registry(公開パッケージ)を使う想定。pull時にログイン不要
REGISTRY_PATH=ghcr.io/4mplelab/unistock
# QNAP側でdocker-compose.prod.ymlを使う場合のみ(未指定時はlatest)
# IMAGE_TAG=v1.0.1
